---
/**
 * Post-registration confirmation page.
 * Shown after POST /api/stores succeeds. Instructs the owner to check their
 * inbox and click the Magic Link to activate the account.
 */

import Card from "../../components/ui/Card";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="メールを確認してください | オーダーマネージャー">
  <main class="check-email-page">
    <Card style="width: min(var(--container-mobile), 100%); padding: var(--space-10) var(--space-8)">
      <h1>メールをご確認ください</h1>
      <p class="body">
        入力いただいたメールアドレス宛に確認メールを送信しました。<br />
        メール内のリンクをクリックすると登録が完了し、管理画面へ移動します。
      </p>
      <p class="note">
        メールが届かない場合は迷惑メールフォルダをご確認ください。<br />
        再送が必要な場合は<a href="/login">ログインページ</a>からメールアドレスを入力してください。
      </p>
    </Card>
  </main>
</Layout>

<style>
  .check-email-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    margin: 0 0 var(--space-4);
    color: var(--color-foreground);
  }

  .body {
    color: var(--color-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4);
  }

  .note {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  a {
    color: var(--color-primary);
    text-underline-offset: 2px;
  }
</style>
