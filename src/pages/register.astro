---
/**
 * ① 申込み画面
 * New store registration. No authentication required.
 * On success the API sets the access_token cookie and the form redirects to /admin.
 */
import RegisterForm from "../components/register/RegisterForm";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>店舗登録 | オーダーマネージャー</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, sans-serif;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100dvh;
        margin: 0;
      }

      .card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 16px rgb(0 0 0 / 0.08);
        padding: 2.5rem 2rem;
        width: min(420px, 100% - 2rem);
      }

      h1 {
        font-size: 1.5rem;
        margin: 0 0 0.5rem;
        color: #111;
      }

      p.subtitle {
        color: #666;
        font-size: 0.9rem;
        margin: 0 0 2rem;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>店舗登録</h1>
      <p class="subtitle">
        店舗名を入力して申込みを完了してください。
      </p>

      <!-- SolidJS island — handles fetch + redirect client-side -->
      <RegisterForm client:load />
    </div>

    <style is:global>
      .register-form .field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 1.2rem;
      }

      .register-form label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #333;
      }

      .register-form input[type="text"] {
        padding: 0.6rem 0.75rem;
        border: 1.5px solid #ccc;
        border-radius: 8px;
        font-size: 1rem;
        width: 100%;
        transition: border-color 0.15s;
      }

      .register-form input[type="text"]:focus {
        outline: none;
        border-color: #6366f1;
      }

      .register-form .error {
        color: #dc2626;
        font-size: 0.875rem;
        margin: 0 0 1rem;
      }

      .register-form button[type="submit"] {
        width: 100%;
        padding: 0.7rem;
        background: #6366f1;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
      }

      .register-form button[type="submit"]:hover:not(:disabled) {
        background: #4f46e5;
      }

      .register-form button[type="submit"]:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
    </style>
  </body>
</html>
