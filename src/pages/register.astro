---
/**
 * Store registration page.
 * No authentication required. On success the form redirects to /register/check-email.
 * The session is created later when the owner clicks the Magic Link in the email.
 */

import RegisterForm from "../components/register/RegisterForm";
import Card from "../components/ui/Card";
import Layout from "../layouts/Layout.astro";
---

<Layout title="店舗登録 | オーダーマネージャー">
  <main class="register-page">
    <Card style="width: min(var(--container-mobile), 100%); padding: var(--space-10) var(--space-8)">
      <h1>店舗登録</h1>
      <p class="subtitle">
        店舗名とメールアドレスを入力してください。確認メールが届いたらリンクをクリックして登録を完了してください。
      </p>
      <RegisterForm client:load />
    </Card>
  </main>
</Layout>

<style>
  .register-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    margin: 0 0 var(--space-2);
    color: var(--color-foreground);
  }

  .subtitle {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-6);
  }
</style>
