---
/**
 * ① 申込み画面
 * New store registration. No authentication required.
 * On success the API sets the access_token cookie and the form redirects to /admin.
 */

import RegisterForm from "../components/register/RegisterForm";
import Card from "../components/ui/Card";
import Layout from "../layouts/Layout.astro";
---

<Layout title="店舗登録 | オーダーマネージャー">
  <main class="register-page">
    <!--
      Card provides background, radius, and shadow.
      Width and padding are overridden via inline style for this specific layout.
    -->
    <Card style="width: min(var(--container-mobile), 100%); padding: var(--space-10) var(--space-8)">
      <h1>店舗登録</h1>
      <p class="subtitle">
        店舗名を入力して申込みを完了してください。
      </p>
      <RegisterForm client:load />
    </Card>
  </main>
</Layout>

<style>
  .register-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    margin: 0 0 var(--space-2);
    color: var(--color-foreground);
  }

  .subtitle {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-6);
  }
</style>
