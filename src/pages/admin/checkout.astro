---
/**
 * ④ 会計・レジ画面（/admin/checkout）
 *
 * Auth is handled by src/middleware.ts; Astro.locals.store is guaranteed non-null here.
 * Renders the SolidJS CheckoutPanel Island that polls for payment_requested orders
 * every 5 seconds and allows staff to complete payment.
 */

import CheckoutPanel from "../../components/admin/CheckoutPanel";
import AdminLayout from "../../layouts/AdminLayout.astro";

// store is guaranteed by src/middleware.ts for all /admin/* routes.
// The guard below should never trigger; it exists to surface misconfiguration clearly.
const store = Astro.locals.store;
if (!store) return Astro.redirect("/login");
---

<AdminLayout
  title="会計・レジ"
  storeName={store.name}
  badge="会計・レジ"
  backHref="/admin"
  backLabel="← 管理トップ"
>
  <CheckoutPanel client:load />
</AdminLayout>
