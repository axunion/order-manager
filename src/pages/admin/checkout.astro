---
/**
 * ④ 会計・レジ画面（/admin/checkout）
 *
 * Auth is handled by src/middleware.ts; Astro.locals.store is guaranteed non-null here.
 * Renders the SolidJS CheckoutPanel Island that polls for payment_requested orders
 * every 5 seconds and allows staff to complete payment.
 */
import CheckoutPanel from "../../components/admin/CheckoutPanel";

// store is guaranteed by src/middleware.ts for all /admin/* routes.
// The guard below should never trigger; it exists to surface misconfiguration clearly.
const store = Astro.locals.store;
if (!store) return Astro.redirect("/register");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{store.name} — 会計・レジ</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        background: #f5f5f5;
        min-height: 100dvh;
      }

      header {
        background: #6366f1;
        color: #fff;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      header h1 {
        margin: 0;
        font-size: 1.2rem;
      }

      .badge {
        font-size: 0.75rem;
        background: rgb(255 255 255 / 0.2);
        padding: 0.2rem 0.5rem;
        border-radius: 99px;
      }

      .nav-link {
        margin-left: auto;
        color: rgb(255 255 255 / 0.8);
        text-decoration: none;
        font-size: 0.875rem;
      }

      .nav-link:hover {
        color: #fff;
      }

      main {
        padding: 2rem 1.5rem;
        max-width: 960px;
        margin: 0 auto;
      }

      /* ── CheckoutPanel Island styles ── */
      .checkout-panel {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .checkout-panel-error {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #b91c1c;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin: 0;
      }

      .checkout-panel-empty {
        background: #fff;
        border-radius: 12px;
        padding: 3rem 2rem;
        text-align: center;
        color: #9ca3af;
      }

      .checkout-panel-empty p {
        margin: 0;
      }

      .checkout-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .checkout-card {
        background: #fffbeb;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        border-left: 4px solid #f59e0b;
      }

      .checkout-card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }

      .checkout-seat-name {
        font-weight: 700;
        font-size: 1.05rem;
        color: #111827;
      }

      .checkout-badge-pay {
        font-size: 0.7rem;
        font-weight: 600;
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fcd34d;
        border-radius: 99px;
        padding: 0.2rem 0.55rem;
        white-space: nowrap;
      }

      .checkout-total {
        margin-left: auto;
        font-weight: 700;
        font-size: 1.1rem;
        color: #111827;
      }

      .checkout-items {
        list-style: none;
        margin: 0 0 1rem;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .checkout-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        background: rgb(255 255 255 / 0.6);
        border-radius: 6px;
        font-size: 0.9rem;
        flex-wrap: wrap;
      }

      .checkout-item-name {
        flex: 1;
        font-weight: 500;
        color: #111827;
        min-width: 0;
      }

      .checkout-item-qty {
        color: #6b7280;
        white-space: nowrap;
      }

      .checkout-item-price {
        font-weight: 600;
        color: #374151;
        white-space: nowrap;
        min-width: 5rem;
        text-align: right;
      }

      .checkout-card-footer {
        display: flex;
        justify-content: flex-end;
        padding-top: 0.75rem;
        border-top: 1px solid #fde68a;
      }

      .btn-checkout {
        background: #059669;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.6rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
      }

      .btn-checkout:hover:not(:disabled) {
        background: #047857;
      }

      .btn-checkout:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>{store.name}</h1>
      <span class="badge">会計・レジ</span>
      <a href="/admin" class="nav-link">← 管理トップ</a>
    </header>

    <main>
      <CheckoutPanel client:load />
    </main>
  </body>
</html>
