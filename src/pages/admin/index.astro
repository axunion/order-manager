---
/**
 * ② 管理画面 — ダッシュボード（最小実装）
 *
 * Auth is handled by src/middleware.ts; Astro.locals.store is guaranteed non-null here.
 * Subsequent steps (Step 3〜6) add menu/seat/order management to this page.
 */

// store is guaranteed by src/middleware.ts for all /admin/* routes.
// The guard below should never trigger; it exists to surface misconfiguration clearly.
const store = Astro.locals.store;
if (!store) return Astro.redirect("/register");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{store.name} — 管理画面</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        background: #f5f5f5;
        min-height: 100dvh;
      }

      header {
        background: #6366f1;
        color: #fff;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      header h1 {
        margin: 0;
        font-size: 1.2rem;
      }

      .badge {
        font-size: 0.75rem;
        background: rgb(255 255 255 / 0.2);
        padding: 0.2rem 0.5rem;
        border-radius: 99px;
      }

      main {
        padding: 2rem 1.5rem;
        max-width: 960px;
        margin: 0 auto;
      }

      .placeholder {
        background: #fff;
        border-radius: 12px;
        padding: 2rem;
        border: 2px dashed #e5e7eb;
        color: #9ca3af;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>{store.name}</h1>
      <span class="badge">管理画面</span>
    </header>

    <main>
      <div class="placeholder">
        <p>
          <a href="/admin/menu" style="color: #6366f1; font-weight: 600;">
            📋 メニュー管理
          </a>
        </p>
        <p style="margin-top: 0.5rem;">
          <a href="/admin/seats" style="color: #6366f1; font-weight: 600;">
            🪑 座席管理・QR 発行
          </a>
        </p>
        <p style="margin-top: 0.5rem;">
          <a href="/admin/orders" style="color: #6366f1; font-weight: 600;">
            🍽️ 注文確認・提供管理
          </a>
        </p>
        <p style="margin-top: 0.5rem; color: #9ca3af;">会計・レジは順次追加されます。</p>
      </div>
    </main>
  </body>
</html>
