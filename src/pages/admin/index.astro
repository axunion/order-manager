---
/**
 * ② 管理画面 — ダッシュボード（最小実装）
 *
 * Auth is handled by src/middleware.ts; Astro.locals.store is guaranteed non-null here.
 * Subsequent steps (Step 3〜6) add menu/seat/order management to this page.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";

// store is guaranteed by src/middleware.ts for all /admin/* routes.
// The guard below should never trigger; it exists to surface misconfiguration clearly.
const store = Astro.locals.store;
if (!store) return Astro.redirect("/login");
---

<AdminLayout title="管理画面" storeName={store.name} badge="管理画面">
  <div class="placeholder">
    <p>
      <a href="/admin/menu" class="menu-link">📋 メニュー管理</a>
    </p>
    <p>
      <a href="/admin/seats" class="menu-link">🪑 座席管理・QR 発行</a>
    </p>
    <p>
      <a href="/admin/orders" class="menu-link">🍽️ 注文確認・提供管理</a>
    </p>
    <p>
      <a href="/admin/checkout" class="menu-link">💰 会計・レジ</a>
    </p>
  </div>
</AdminLayout>

<style>
  .placeholder {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    border: 2px dashed var(--color-border);
    color: var(--color-subtle-foreground);
    text-align: center;
  }

  .placeholder p {
    margin: 0;
  }

  .placeholder p + p {
    margin-top: var(--space-2);
  }

  .menu-link {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    text-decoration: none;
  }

  .menu-link:hover {
    text-decoration: underline;
  }
</style>
