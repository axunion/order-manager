---
/**
 * ② 管理画面 — 注文確認・提供管理（/admin/orders）
 *
 * Auth is handled by src/middleware.ts; Astro.locals.store is guaranteed non-null here.
 * Renders the SolidJS OrderBoard Island that polls for active orders every 5 seconds
 * and allows staff to mark line items as 'served'.
 */

import OrderBoard from "../../components/admin/OrderBoard";
import AdminLayout from "../../layouts/AdminLayout.astro";

// store is guaranteed by src/middleware.ts for all /admin/* routes.
// The guard below should never trigger; it exists to surface misconfiguration clearly.
const store = Astro.locals.store;
if (!store) return Astro.redirect("/register");
---

<AdminLayout
  title="注文管理"
  storeName={store.name}
  badge="注文管理"
  backHref="/admin"
  backLabel="← 管理トップ"
>
  <OrderBoard client:load />
</AdminLayout>
