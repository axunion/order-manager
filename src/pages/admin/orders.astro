---
/**
 * ② 管理画面 — 注文確認・提供管理（/admin/orders）
 *
 * Auth is handled by src/middleware.ts; Astro.locals.store is guaranteed non-null here.
 * Renders the SolidJS OrderBoard Island that polls for active orders every 5 seconds
 * and allows staff to mark line items as 'served'.
 */
import OrderBoard from "../../components/admin/OrderBoard";

// store is guaranteed by src/middleware.ts for all /admin/* routes.
// The guard below should never trigger; it exists to surface misconfiguration clearly.
const store = Astro.locals.store;
if (!store) return Astro.redirect("/register");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{store.name} — 注文管理</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        background: #f5f5f5;
        min-height: 100dvh;
      }

      header {
        background: #6366f1;
        color: #fff;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      header h1 {
        margin: 0;
        font-size: 1.2rem;
      }

      .badge {
        font-size: 0.75rem;
        background: rgb(255 255 255 / 0.2);
        padding: 0.2rem 0.5rem;
        border-radius: 99px;
      }

      .nav-link {
        margin-left: auto;
        color: rgb(255 255 255 / 0.8);
        text-decoration: none;
        font-size: 0.875rem;
      }

      .nav-link:hover {
        color: #fff;
      }

      main {
        padding: 2rem 1.5rem;
        max-width: 960px;
        margin: 0 auto;
      }

      /* ── OrderBoard Island styles ── */
      .order-board {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .order-board-error {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #b91c1c;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin: 0;
      }

      .order-board-empty {
        background: #fff;
        border-radius: 12px;
        padding: 3rem 2rem;
        text-align: center;
        color: #9ca3af;
      }

      .order-board-empty p {
        margin: 0;
      }

      .order-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .order-card {
        background: #fff;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        border-left: 4px solid #6366f1;
      }

      .order-card--pay-requested {
        border-left-color: #f59e0b;
        background: #fffbeb;
      }

      .order-card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }

      .order-seat-name {
        font-weight: 700;
        font-size: 1.05rem;
        color: #111827;
      }

      .order-badge-pay {
        font-size: 0.7rem;
        font-weight: 600;
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fcd34d;
        border-radius: 99px;
        padding: 0.2rem 0.55rem;
        white-space: nowrap;
      }

      .order-total {
        margin-left: auto;
        font-weight: 700;
        font-size: 1rem;
        color: #111827;
      }

      .order-items {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .order-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        background: #f9fafb;
        border-radius: 6px;
        font-size: 0.9rem;
        flex-wrap: wrap;
      }

      .order-item--served {
        opacity: 0.5;
      }

      .order-item-name {
        flex: 1;
        font-weight: 500;
        color: #111827;
        min-width: 0;
      }

      .order-item-qty {
        color: #6b7280;
        white-space: nowrap;
      }

      .order-item-price {
        font-weight: 600;
        color: #374151;
        white-space: nowrap;
        min-width: 5rem;
        text-align: right;
      }

      .btn-serve {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #6ee7b7;
        border-radius: 6px;
        padding: 0.25rem 0.65rem;
        font-size: 0.8rem;
        cursor: pointer;
        white-space: nowrap;
      }

      .btn-serve:hover:not(:disabled) {
        background: #d1fae5;
      }

      .btn-serve:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>{store.name}</h1>
      <span class="badge">注文管理</span>
      <a href="/admin" class="nav-link">← 管理トップ</a>
    </header>

    <main>
      <OrderBoard client:load />
    </main>
  </body>
</html>
