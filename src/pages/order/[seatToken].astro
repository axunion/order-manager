---
/**
 * ③ 顧客注文画面（/order/:seatToken）
 *
 * Validates the qr_token URL parameter server-side.
 * If invalid, renders an error page (no redirect — the QR token itself is the
 * only identifier the customer has).
 * If valid, mounts the OrderScreen SolidJS Island with the resolved seat info.
 */
import { env } from "cloudflare:workers";
import OrderScreen from "../../components/order/OrderScreen";
import { createDb } from "../../db/client";
import { getSeatByQrToken } from "../../lib/auth";

const { seatToken } = Astro.params;

// seatToken is guaranteed by file-based routing ([seatToken].astro), but
// guard defensively to keep TypeScript happy.
if (!seatToken) {
  return Astro.redirect("/");
}

const db = createDb(env.DB);
const seat = await getSeatByQrToken(db, seatToken);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seat ? `${seat.name} — ご注文` : "ページが見つかりません"}</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        background: #f5f5f5;
        min-height: 100dvh;
      }

      header {
        background: #6366f1;
        color: #fff;
        padding: 1rem 1.5rem;
      }

      header h1 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
      }

      header p {
        margin: 0.25rem 0 0;
        font-size: 0.8rem;
        opacity: 0.8;
      }

      main {
        padding: 1rem;
        max-width: 640px;
        margin: 0 auto;
      }

      /* ── Not found ── */
      .not-found {
        text-align: center;
        padding: 4rem 1rem;
        color: #6b7280;
      }

      .not-found h2 {
        margin: 0 0 0.5rem;
        color: #374151;
      }

      /* ── Loading / error ── */
      .order-loading {
        text-align: center;
        color: #9ca3af;
        padding: 2rem 0;
        margin: 0;
      }

      .order-error {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #b91c1c;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin: 1rem 0;
      }

      /* ── Menu section ── */
      .menu-section {
        background: #fff;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
      }

      .menu-section h2 {
        margin: 0 0 1rem;
        font-size: 1rem;
        font-weight: 600;
        color: #111827;
      }

      .menu-group {
        margin-bottom: 1.25rem;
      }

      .menu-category {
        margin: 0 0 0.5rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #f3f4f6;
        padding-bottom: 0.25rem;
      }

      .menu-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .menu-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid #f9fafb;
        flex-wrap: wrap;
      }

      .menu-item:last-child {
        border-bottom: none;
      }

      .menu-item-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .menu-item-name {
        font-size: 0.95rem;
        font-weight: 500;
        color: #111827;
      }

      .menu-item-price {
        font-size: 0.85rem;
        color: #6366f1;
        font-weight: 600;
      }

      .menu-item-order {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .quantity-control {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        overflow: hidden;
      }

      .qty-btn {
        background: #f9fafb;
        border: none;
        border-radius: 0;
        padding: 0.3rem 0.6rem;
        font-size: 1rem;
        cursor: pointer;
        color: #374151;
        min-width: 2rem;
        line-height: 1;
      }

      .qty-btn:hover:not(:disabled) {
        background: #f3f4f6;
      }

      .qty-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .qty-value {
        font-size: 0.9rem;
        font-weight: 600;
        color: #111827;
        min-width: 1.5rem;
        text-align: center;
        padding: 0 0.25rem;
      }

      .btn-order {
        background: #6366f1;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 0.4rem 0.85rem;
        font-size: 0.85rem;
        cursor: pointer;
        white-space: nowrap;
      }

      .btn-order:hover:not(:disabled) {
        background: #4f46e5;
      }

      .btn-order:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .menu-error {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #b91c1c;
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
      }

      .menu-success {
        background: #f0fdf4;
        border: 1px solid #86efac;
        color: #15803d;
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
      }

      .empty {
        color: #9ca3af;
        text-align: center;
        padding: 1rem 0;
        margin: 0;
        font-size: 0.9rem;
      }

      /* ── Order summary section ── */
      .order-summary {
        background: #fff;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
      }

      .order-summary h2 {
        margin: 0 0 1rem;
        font-size: 1rem;
        font-weight: 600;
        color: #111827;
      }

      .summary-error {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #b91c1c;
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
      }

      .order-items {
        list-style: none;
        margin: 0 0 1rem;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .order-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        padding: 0.25rem 0;
        border-bottom: 1px solid #f9fafb;
      }

      .order-item:last-child {
        border-bottom: none;
      }

      .order-item-name {
        flex: 1;
        color: #374151;
      }

      .order-item-qty {
        color: #9ca3af;
        font-size: 0.8rem;
        white-space: nowrap;
      }

      .order-item-price {
        color: #111827;
        font-weight: 500;
        white-space: nowrap;
      }

      .order-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0 1rem;
        border-top: 2px solid #f3f4f6;
        font-weight: 600;
        font-size: 1rem;
        color: #111827;
      }

      .total-amount {
        font-size: 1.2rem;
        color: #6366f1;
      }

      .btn-payment {
        width: 100%;
        background: #059669;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.85rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        letter-spacing: 0.02em;
      }

      .btn-payment:hover:not(:disabled) {
        background: #047857;
      }

      .btn-payment:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .payment-requested-msg {
        background: #fef9c3;
        border: 1px solid #fde047;
        color: #854d0e;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        text-align: center;
        font-weight: 500;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>{seat ? seat.name : "注文画面"}</h1>
      <p>セルフオーダー</p>
    </header>

    <main>
      {
        seat ? (
          <OrderScreen
            client:load
            seatToken={seatToken}
            seatName={seat.name}
          />
        ) : (
          <div class="not-found">
            <h2>ページが見つかりません</h2>
            <p>QR コードを再度ご確認いただくか、スタッフにお声がけください。</p>
          </div>
        )
      }
    </main>
  </body>
</html>
