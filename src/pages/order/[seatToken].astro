---
/**
 * ③ 顧客注文画面（/order/:seatToken）
 *
 * Validates the qr_token URL parameter server-side.
 * If invalid, renders an error page (no redirect — the QR token itself is the
 * only identifier the customer has).
 * If valid, mounts the OrderScreen SolidJS Island with the resolved seat info.
 */
import { env } from "cloudflare:workers";
import OrderScreen from "../../components/order/OrderScreen";
import { createDb } from "../../db/client";
import Layout from "../../layouts/Layout.astro";
import { getSeatByQrToken } from "../../lib/auth";

const { seatToken } = Astro.params;

// seatToken is guaranteed by file-based routing ([seatToken].astro), but
// guard defensively to keep TypeScript happy.
if (!seatToken) {
  return Astro.redirect("/");
}

const db = createDb(env.DB);
// Wrap in try/catch so a D1 error (outage, quota) renders the not-found UI
// rather than propagating an unhandled 500.
let seat: Awaited<ReturnType<typeof getSeatByQrToken>> = null;
try {
  seat = await getSeatByQrToken(db, seatToken);
} catch {
  seat = null;
}
---

<Layout title={seat ? `${seat.name} — ご注文` : "ページが見つかりません"}>
  <header class="order-header">
    <h1>{seat ? seat.name : "注文画面"}</h1>
    <p>セルフオーダー</p>
  </header>

  <main class="order-main">
    {
      seat ? (
        <OrderScreen
          client:load
          seatToken={seatToken}
          seatName={seat.name}
        />
      ) : (
        <div class="not-found">
          <h2>ページが見つかりません</h2>
          <p>QR コードを再度ご確認いただくか、スタッフにお声がけください。</p>
        </div>
      )
    }
  </main>
</Layout>

<style>
  .order-header {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    padding: var(--space-4) var(--space-6);
  }

  .order-header h1 {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
  }

  .order-header p {
    margin: var(--space-1) 0 0;
    font-size: var(--text-xs);
    opacity: 0.8;
  }

  .order-main {
    padding: var(--space-4);
    max-width: 640px;
    margin: 0 auto;
  }

  /* ── Not found ── */
  .not-found {
    text-align: center;
    padding: var(--space-10) var(--space-4);
    color: var(--color-muted-foreground);
  }

  .not-found h2 {
    margin: 0 0 var(--space-2);
    color: var(--color-foreground);
  }
</style>
