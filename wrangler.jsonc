{
  "name": "order-manager",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "order-manager",
      // Replace with the real database_id obtained from `wrangler d1 create order-manager`.
      // For local-only development the value is not verified by wrangler --local,
      // so a placeholder UUID is acceptable until the Cloudflare account is configured.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
