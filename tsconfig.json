{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@order/db": ["./packages/db/src"],
      "@order/core": ["./packages/core/src"],
      "@order/core/types": ["./packages/core/src/types"],
      "@order/core/domain": ["./packages/core/src/domain"],
      "@order/core/client": ["./packages/core/src/client"],
      "@order/ui": ["./packages/ui/src"],
      "@order/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["packages/*/src/**/*", "apps/*/src/**/*"],
  "exclude": ["**/dist", "**/node_modules"]
}
