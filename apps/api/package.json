{
  "name": "@order/api",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply order-manager --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@order/core": "workspace:*",
    "@order/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.26",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "^4.20260621.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
