{
  "name": "order-manager-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "order-manager",
      // Replace with the real database_id from `wrangler d1 create order-manager`.
      // A placeholder UUID is acceptable for local-only development.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ]
}
