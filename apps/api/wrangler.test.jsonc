{
  // Wrangler config for vitest-pool-workers (API integration tests).
  // Excludes "main" intentionally — tests import Hono routes directly.
  "name": "order-manager-api-test",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "order-manager",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "order-manager-images-test"
    }
  ],
  "vars": {
    "ADMIN_ORIGIN": "http://admin.localhost",
    "ORDER_ORIGIN": "http://order.localhost",
    "SIGNUP_ORIGIN": "http://signup.localhost",
    "SHIFT_ORIGIN": "http://shift.localhost",
    "COOKIE_DOMAIN": "",
    "RESEND_API_KEY": "",
    "MAIL_FROM": "",
    "ENVIRONMENT": "production"
  }
}
